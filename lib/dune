(library
 (name why3find)
 (public_name why3find)
 (flags "-open" "Why3findUtils")
 (libraries Why3findUtils why3 dune-site)
 (instrumentation (backend bisect_ppx)))

(rule
  (target config.ml)
  (action
    (write-file %{target}
      "let version = \"%{version:why3find}\"")))

(generate_sites_module
  (module global)
  (sites why3find))
