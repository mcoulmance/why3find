type symbol =
  | Ref of Id.id
  | Def of Id.id
  | Clone of Id.id * Id.id list
  (* cloned theory, target scope and declared new symbols *)
  | Section of string
  (* foldable section *)

type env

val parse :
  ?doc:bool -> ?filename:string ->
  env:Wenv.env -> src:Docref.source ->
  string -> symbol Rangemap.t
