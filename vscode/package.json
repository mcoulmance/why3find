{
  "name": "why3-platform",
  "displayName": "Why3 Platform",
  "description": "Support for Why3 platform",
  "repository": "https://git.frama-c.com/pub/why3find",
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "1.2.0+dev",
  "icon": "./why3.platform.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/main.js",
  "activationEvents": [
    "onlanguage:why3"
  ],
  "contributes": {
    "languages": [
      {
        "id": "why3",
        "aliases": [
          "Why3",
          "why3"
        ],
        "extensions": [
          ".mlw"
        ],
        "configuration": "./why3.language.json"
      }
    ],
    "grammars": [
      {
        "language": "why3",
        "scopeName": "source.why3",
        "path": "./why3.syntax.json"
      }
    ],
    "commands": [
      {
        "category": "Why3",
        "command": "why3.lsp.start",
        "title": "Restart the Why3 LSP Server"
      },
      {
        "category": "Why3",
        "command": "why3.lsp.stop",
        "title": "Stop the Why3 LSP Server"
      },
      {
        "category": "Why3",
        "command": "why3.dap.start",
        "title": "Start the Why3 Debugger",
        "enablement": "!inDebugMode",
        "icon": "$(debug-alt)"
      },
      {
        "category": "Why3",
        "command": "why3.diagnostic.clear",
        "title": "Clear Failed Proofs",
        "icon": "$(clear-all)"
      }
    ],
    "submenus": [
      {
        "id": "why3.menu",
        "label": "Why3"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "why3.menu",
          "group": "action"
        }
      ],
      "editor/title/run": [
        {
          "command": "why3.dap.start",
          "when": "resourceLangId == why3",
          "group": "navigation@1"
        }
      ],
      "why3.menu": [
        {
          "command": "why3.lsp.start",
          "when": "resourceLangId == why3"
        },
        {
          "command": "why3.lsp.stop",
          "when": "resourceLangId == why3"
        },
        {
          "command": "why3.diagnostic.clear",
          "when": "resourceLangId == why3"
        }
      ]
    },
    "breakpoints": [ { "language": "why3" } ],
    "debuggers": [
      {
        "type": "why3",
        "label": "Why3 Debug",
        "languages": [ "why3" ]
      }
    ]
  },
  "scripts": {
    "start": "tsc -b -w",
    "typecheck": "tsc --noEmit",
    "build": "esbuild ./extension/main.ts --bundle --platform=node --external:vscode --minify --outfile=./out/main.js",
    "package": "vsce package --yarn"
  },
  "devDependencies": {
    "@types/node": "^18.14.6",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.29.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
