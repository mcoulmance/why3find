{
  "name": "why3-platform",
  "displayName": "Why3 Platform",
  "description": "Support for Why3 platform",
  "repository": "https://git.frama-c.com/pub/why3find",
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "0.0.1",
  "icon": "./why3.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [ {
        "id": "why3",
        "aliases": [ "Why3", "why3" ],
        "extensions": [ ".mlw" ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "why3",
        "scopeName": "source.why3",
        "path": "./syntaxes/why3.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^18.14.6",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/vscode": "^1.90.0",
    "vscode-languageclient": "^9.0.1"
  }
}
