{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Why3",
	"patterns": [
		{ "include": "#keywords" },
		{ "include": "#constants" },
		{ "include": "#comments" }
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.why3",
					"match": "\\b(as|axiom|begin|break|clone|coinductive|constant|continue|do|done|downto|else|end|exception|export|for|fun|function|goal|if|import|in|inductive|lemma|let|match|meta|module|predicate|raise|scope|then|theory|to|try|type|use|val|while|with)\\b"
				},
				{
					"name": "keyword.operator.why3",
					"match": "[=<>~+*!?$&|.:@^#/\\\\%-]'*"
				},
				{
					"name": "storage.modifier",
					"match": "\\b(any|abstract|alias|assert|by|check|diverges|exists|ensures|epsilon|forall|ghost|invariant|label|mutable|not|old|partial|private|pure|range|ref|rec|raises|reads|requires|returns|so|variant|writes)\\b"
				},
				{
					"name": "invalid.why3",
					"match": "\\b(assume)\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "string.why3",
					"begin": "\"", "end": "\""
				},
				{
					"name": "constant.numeric.why3",
					"match": "\\b[0-9\\.]+\\b"
				},
				{
					"name": "constant.language.why3",
					"match": "\\b(bool|false|int|real|true|unit)\\b"
				},
				{
					"name": "constant.language.why3",
					"match": "\\b(([a-z]+\\.)*[A-Z][a-z0-9_]*)\\b"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.block",
					"begin": "\\(\\*", "end": "\\*\\)",
					"patterns": [
						{ "match": "\\(\\*+\\)" },
						{ "include": "#comments" }
					]
				}
			]
		}
	},
	"scopeName": "source.why3"
}
